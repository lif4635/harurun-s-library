import sys

@pure
@llvm
def _codon_srem(value: int, mod: int) -> int:
    %result = srem i64 %value, %mod
    ret i64 %result

@pure
@llvm
def _codon_sdiv(value: int, divisor: int) -> int:
    %result = sdiv i64 %value, %divisor
    ret i64 %result

@extend
class File:
    def readline(self):
        for line in self:
            return line
        return ""

@extend
class int:
    @overload
    def __mod__(self, other: int):
        return _codon_mod(self, other)

    @overload
    def __floordiv__(self, other: int):
        if other == 0:
            raise ZeroDivisionError("integer division by zero")
        if self == -9223372036854775807 - 1 and other == -1:
            raise OverflowError("integer division exceeds signed 64bit")
        q = _codon_sdiv(self, other)
        if _codon_srem(self, other) and (self < 0) != (other < 0):
            q -= 1
        return q

    @pure
    @llvm
    def bit_length(self) -> int:
        declare i64 @llvm.ctlz.i64(i64, i1)
        %negative = icmp slt i64 %self, 0
        %negated = sub i64 0, %self
        %magnitude = select i1 %negative, i64 %negated, i64 %self
        %zeros = call i64 @llvm.ctlz.i64(i64 %magnitude, i1 false)
        %result = sub i64 64, %zeros
        ret i64 %result

    def bit_count(self):
        value = UInt[64](self)
        if self < 0:
            value = UInt[64](0) - value
        return value.popcnt()

    @overload
    def __rshift__(self, other: bool):
        return self >> int(other)

def _codon_mod(value: int, mod: int):
    if mod == 0:
        raise ZeroDivisionError("integer modulo by zero")
    if mod == -1:
        return 0
    result = _codon_srem(value, mod)
    if result and (result < 0) != (mod < 0):
        result += mod
    return result

def _codon_mod_wide(value: Int[128], mod: Int[128]):
    if mod == Int[128](0):
        raise ZeroDivisionError("integer modulo by zero")
    result = value % mod
    if result and (result < Int[128](0)) != (mod < Int[128](0)):
        result += mod
    return int(result)

def _codon_pow(base: int, exponent: int, modulus: int):
    if modulus == 998244353 or modulus == -998244353:
        value = base % 998244353
        power = UInt[64](exponent)
        if exponent < 0:
            if value == 0:
                raise ValueError("base is not invertible for the given modulus")
            value = _codon_pow_positive(value, UInt[64](998244351))
            power = UInt[64](0) - power
        result = _codon_pow_positive(value, power)
        if modulus < 0 and result:
            result -= 998244353
        return result
    return _codon_pow_wide(base, exponent, modulus)

def _codon_pow_positive(value: int, power: UInt[64]):
    result = 1
    while power:
        if power & UInt[64](1):
            result = result * value % 998244353
        value = value * value % 998244353
        power >>= UInt[64](1)
    return result

def _codon_pow_wide(base: int, exponent: int, modulus: int):
    if modulus == 0:
        raise ValueError("pow() modulus must be nonzero")
    mod = Int[128](modulus)
    negative = mod < Int[128](0)
    if negative:
        mod = -mod
    value = Int[128](_codon_mod_wide(Int[128](base), mod))
    power = Int[128](exponent)
    if power < Int[128](0):
        a, b = value, mod
        x, y = Int[128](1), Int[128](0)
        while b:
            q = a // b
            a, b = b, a - q * b
            x, y = y, x - q * y
        if a != Int[128](1):
            raise ValueError("base is not invertible for the given modulus")
        value = Int[128](_codon_mod_wide(x, mod))
        power = -power
    result = Int[128](1) % mod
    while power:
        if power & Int[128](1):
            result = result * value % mod
        value = value * value % mod
        power >>= Int[128](1)
    if negative and result:
        result -= mod
    return int(result)

def _codon_array(code, values):
    if code != "I":
        raise ValueError("only unsigned coefficient arrays are supported")
    return list(values)

"""一点加算・prefix和・区間和を対数時間で扱うBIT。"""

class BIT:

    def __init__(self, values):
        if isinstance(values, int):
            if values < 0:
                raise ValueError('size must be nonnegative')
            self.n = values
            self.bit = [0] * (values + 1)
        else:
            values = list(values)
            n = len(values)
            bit = [0] + values
            for index in range(1, n + 1):
                parent = index + (index & -index)
                if parent <= n:
                    bit[parent] += bit[index]
            self.n = n
            self.bit = bit

    def add(self, index, value):
        """a[index]へvalueを加える。"""
        index += 1
        bit = self.bit
        while index <= self.n:
            bit[index] += value
            index += index & -index

    def prefix_sum(self, right):
        """半開区間[0, right)の和を返す。"""
        result = 0
        bit = self.bit
        while right:
            result += bit[right]
            right &= right - 1
        return result

    def sum(self, left, right=None):
        """[left, right)の和を返す。right省略時は[0, left)の和。"""
        if right is None:
            return self.prefix_sum(left)
        return self.prefix_sum(right) - self.prefix_sum(left)

    def get(self, index):
        """a[index]を返す。"""
        return self.sum(index, index + 1)

    def set(self, index, value):
        """a[index]をvalueへ置き換える。"""
        self.add(index, value - self.get(index))

    def lower_bound(self, target):
        """prefix和がtarget以上になる最小の右端を返す。"""
        if target <= 0:
            return 0
        index = 0
        step = 1 << self.n.bit_length() - 1 if self.n else 0
        bit = self.bit
        while step:
            next_index = index + step
            if next_index <= self.n and bit[next_index] < target:
                target -= bit[next_index]
                index = next_index
            step >>= 1
        return index if index < self.n else self.n

    def __len__(self):
        return self.n

    def tolist(self):
        """現在の要素列をlistで返す。O(N)。"""
        values = self.bit[1:]
        for index in range(self.n, 0, -1):
            parent = index + (index & -index)
            if parent <= self.n:
                values[parent - 1] -= values[index - 1]
        return values

    def __str__(self):
        return str(self.tolist())

    def __repr__(self):
        return f'BIT({self.tolist()!r})'
